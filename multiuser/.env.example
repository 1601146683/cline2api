# ------- 必改 -------
# 上游管理后台密码（没有它，后台在宿主机上任何进程都能进）
ADMIN_PASSWORD=change-me-please

# 上游 API Key：随机长串。填了之后上游代理端点也必须带 Key
# 生成: openssl rand -hex 24
UPSTREAM_KEY=replace-with-random-hex

# 网关管理接口令牌（/__gw/* 用它保护）
# 生成: openssl rand -hex 16
ADMIN_TOKEN=replace-with-random-token

# ------- 说明 -------
# 本目录（multiuser/）放在仓库内，构建上下文是仓库根目录 ../，
# 因此不需要预先拉源码，直接 docker compose up -d --build 即可。

# ------- 选改 -------
# auto = 还没建任何用户时透明转发；建了第一个用户就自动强制 Key 鉴权
# key  = 永远要求 Key（公网生产建议用这个）
# pass = 不鉴权（仅内网/自用）
AUTH_MODE=auto

GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8080
UPSTREAM_HOST_PORT=3457
TZ=Asia/Shanghai
MAX_BODY_MB=32
UPSTREAM_TIMEOUT=600
APP_VERSION=local

# 构建上游镜像用哪个 Dockerfile：
#   Dockerfile.gw  = 官方 + GOPROXY（受限网络推荐，默认）
#   Dockerfile     = 仓库根目录的上游官方原文件
UPSTREAM_DOCKERFILE=Dockerfile.gw
# Go 模块代理；直连 proxy.golang.org 正常时可设 https://proxy.golang.org,direct
GOPROXY=https://goproxy.cn,direct
